
<header class="navbar">
    <div class="navbar-container">
        <a href="/" class="navbar-brand">MediDiag</a>
        
        <button class="mobile-menu-btn" type="button" aria-label="Toggle menu" aria-expanded="false"><span aria-hidden="true">&#9776;</span></button>
        
        <nav class="navbar-nav">
            <a href="/">Home</a>
            <a href="/about">About</a>
            <a href="/features" >Features</a>
            <a href="/faqs" >FAQs</a>
            <a href="/contact">Contact</a>
            
            <% if (user) { %>
    <div class="user-menu user-menu-simple">
        <a class="user-trigger"
           href="/<%= user.role %>/dashboard"
           aria-label="Profile">
            <div class="user-avatar">
                <%= (user.full_name || user.email || 'U').charAt(0).toUpperCase() %>
            </div>
            <span class="user-name-text">
                <% if (user.role === 'patient') { %>Patient Portal<% } else { %>Doctor Portal<% } %>
            </span>
        </a>
        <a href="/auth/logout" class="btn btn-outline btn-logout">
            <i class="fas fa-sign-out-alt"></i> Logout
        </a>
    </div>
<% } else { %>
    <div class="navbar-actions">
        <div class="auth-buttons">
            <a href="/auth/login" class="btn btn-primary btn-login">Login</a>
            <a href="/auth/register" class="btn btn-outline">Sign Up</a>
        </div>
    </div>
<% } %>
        <button class="mobile-menu-close" type="button" aria-label="Close menu"><span aria-hidden="true">&times;</span></button>
        </nav>
    </div>
</header>


<script>
document.addEventListener('DOMContentLoaded', function() {
    const signupTrigger = document.querySelector('.signup-trigger');
    const signupDropdown = document.querySelector('.signup-dropdown-menu');
    
    if (signupTrigger && signupDropdown) {
        // Toggle dropdown on click
        signupTrigger.addEventListener('click', function(e) {
            e.stopPropagation();
            signupDropdown.classList.toggle('show');
        });
        
        // Close dropdown when clicking outside
        document.addEventListener('click', function(e) {
            if (!signupTrigger.contains(e.target) && !signupDropdown.contains(e.target)) {
                signupDropdown.classList.remove('show');
            }
        });
        
        // Close dropdown when an option is selected
        const signupOptions = document.querySelectorAll('.signup-option-btn');
        signupOptions.forEach(option => {
            option.addEventListener('click', function() {
                signupDropdown.classList.remove('show');
            });
        });
        
        // Close dropdown on escape key
        document.addEventListener('keydown', function(e) {
            if (e.key === 'Escape') {
                signupDropdown.classList.remove('show');
            }
        });
    }
});
</script>


