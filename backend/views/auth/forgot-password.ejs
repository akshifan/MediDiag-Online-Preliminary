<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title><%= title %></title>

    <link
        rel="stylesheet"
        href="/main/main.css"
    >

    <link
        rel="stylesheet"
        href="/navbar/navbar.css"
    >

    <link
        rel="stylesheet"
        href="/login/login.css"
    >

    <link
        rel="stylesheet"
        href="/footer/footer.css"
    >

    <link
        rel="stylesheet"
        href="/portal/password.css"
    >

    <link
        rel="stylesheet"
        href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css"
    >
</head>

<body>

    <%- include('../headers/launchheader') %>

    <div class="password-page">

        <div class="password-card">

            <div class="password-header">

                <div class="password-icon">
                    <i class="fas fa-key"></i>
                </div>

                <h1>Forgot Password?</h1>

                <p>
                    Enter your registered email address and
                    we'll send you a password reset link.
                </p>

            </div>

            <% if (error) { %>
                <div class="password-alert password-alert-error">
                    <%= error %>
                </div>
            <% } %>

            <% if (success) { %>
                <div class="password-alert password-alert-success">
                    <%= success %>
                </div>
            <% } %>

            <form
                method="POST"
                action="/auth/forgot-password"
            >

                <div class="form-group">

                    <label class="form-label">
                        Email Address
                    </label>

                    <input
                        type="email"
                        name="email"
                        class="form-control"
                        placeholder="Enter your email"
                        required
                        autocomplete="email"
                    >

                </div>

                <button
                    type="submit"
                    class="btn btn-primary password-submit"
                >
                    <i class="fas fa-paper-plane"></i>
                    Send Reset Link
                </button>

            </form>

            <div class="password-back">
                <a href="/auth/login">
                    <i class="fas fa-arrow-left"></i>
                    Back to Login
                </a>
            </div>

        </div>

    </div>

    <script src="/navbar/navbar.js"></script>

</body>
</html>