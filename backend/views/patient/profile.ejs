

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>My Profile - MediDiag</title>
    <link rel="stylesheet" href="/main/main.css">
    <link rel="stylesheet" href="/patient/appointments.css">
    <link rel="stylesheet" href="/navbar/navbar.css">
        <link rel="stylesheet" href="/footer/footer.css">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/portal/portal-fixes.css">
</head>
<body>
    <%- include('../headers/launchheader') %>
    
    <!-- Medical Background Elements -->
    <div class="medical-background">
        <i class="fas fa-heart medical-icon heart"></i>
        <i class="fas fa-stethoscope medical-icon stethoscope"></i>
        <i class="fas fa-pills medical-icon pill"></i>
        <i class="fas fa-hospital medical-icon hospital"></i>
        <i class="fas fa-user medical-icon user"></i>
        <i class="fas fa-shield-alt medical-icon clipboard"></i>
    </div>

    <div class="container patient-dashboard">
        <div class="dashboard-grid">
            <aside class="sidebar">
                <div class="sidebar-header">
                    
                    <h3><%= patient.full_name %></h3>
                </div>
                <nav class="sidebar-nav">
                    <ul>
                        <li>
                            <a href="/patient/dashboard">
                                <i class="fas fa-tachometer-alt"></i>
                                Dashboard
                            </a>
                        </li>
                        <li>
                            <a href="/patient/doctors">
                                <i class="fas fa-user-md"></i>
                                Find Doctors
                            </a>
                        </li>
                        <li>
                            <a href="/patient/appointments">
                                <i class="fas fa-calendar-check"></i>
                                My Appointments
                            </a>
                        </li>
                        <li><a href="/patient/chats"><i class="fas fa-comments"></i> Chats</a></li>
                        <li>
                            <a href="/patient/profile" class="active">
                                <i class="fas fa-user"></i>
                                Profile
                            </a>
                        </li>
                        <li>
                            <a href="/auth/logout">
                                <i class="fas fa-sign-out-alt"></i>
                                Logout
                            </a>
                        </li>
                    </ul>
                </nav>
            </aside>

            <main class="dashboard-content">  
                <section class="chat-page-header profile-page-header">
    <h1>
        <i class="fas fa-user-circle"></i>
        Personal Information
    </h1>

    <p>
        Update your personal details and contact information
    </p>
</section>            
                <div class="profile-section">
                    
                    <div class="card">
                        
                        <form id="profile-form">
                            <div class="form-row">
                                <div class="form-group">
                                    <label class="form-label">Full Name</label>
                                    <input type="text" name="full_name" class="form-control" value="<%= patient.full_name %>" required>
                                </div>
                                <div class="form-group">
                                    <label class="form-label">Email</label>
                                    <input type="email" class="form-control" value="<%= patient.email %>" disabled>
                                    <small class="form-text">Contact support to change email</small>
                                </div>
                            </div>

                            <div class="form-row">
                                <div class="form-group">
                                    <label class="form-label">Date of Birth</label>
<input
    type="date"
    name="date_of_birth"
    class="form-control"
    value="<%
        if (patient.date_of_birth) {
            if (patient.date_of_birth instanceof Date) {
                const d = patient.date_of_birth;
                const yyyy = d.getUTCFullYear();
                const mm = String(d.getUTCMonth() + 1).padStart(2, '0');
                const dd = String(d.getUTCDate()).padStart(2, '0');
                %><%= `${yyyy}-${mm}-${dd}` %><%
            } else {
                const dob = String(patient.date_of_birth).trim();
                %><%= dob.substring(0, 10) %><%
            }
        }
    %>"
>
                                </div>
                                <div class="form-group">
                                    <label class="form-label">Gender</label>
                                    <select name="gender" class="form-control">
                                        <option value="Male" <%= patient.gender === 'Male' ? 'selected' : '' %>>Male</option>
                                        <option value="Female" <%= patient.gender === 'Female' ? 'selected' : '' %>>Female</option>
                                        <option value="Other" <%= patient.gender === 'Other' ? 'selected' : '' %>>Other</option>
                                        <option value="Prefer not to say" <%= patient.gender === 'Prefer not to say' ? 'selected' : '' %>>Prefer not to say</option>
                                    </select>
                                </div>
                            </div>

                            <div class="form-group">
                                <label class="form-label">Phone Number</label>
                                <input type="tel" name="phone" class="form-control" value="<%= patient.phone %>" placeholder="Enter your phone number">
                            </div>

                            <div class="form-group">
                                <label class="form-label">Address</label>
                                <textarea name="address" class="form-control" rows="3" placeholder="Enter your complete address"><%= patient.address %></textarea>
                            </div>

                            <div class="form-group">
                                <label class="form-label">Emergency Contact</label>
                                <input type="text" name="emergency_contact" class="form-control" value="<%= patient.emergency_contact %>" placeholder="Name and phone number">
                                <small class="form-text">Please provide name and phone number of your emergency contact</small>
                            </div>

                            <button type="submit" class="btn btn-primary">
                                <i class="fas fa-save"></i>
                                Update Profile
                            </button>
                        </form>
                    </div>
                </div>

                <div class="security-section">
    <div class="card">

        <div class="section-header">
            <h2>
                <i class="fas fa-shield-alt"></i>
                Update Password
            </h2>

            <p>
                Change your account password securely.
            </p>
        </div>

        <form id="change-password-form">

            <div class="form-group">
                <label class="form-label">
                    Current Password
                </label>

                <input
                    type="password"
                    name="currentPassword"
                    class="form-control"
                    required
                    autocomplete="current-password"
                >
            </div>

            <div class="form-group">
                <label class="form-label">
                    New Password
                </label>

                <input
                    type="password"
                    name="newPassword"
                    class="form-control"
                    minlength="6"
                    required
                    autocomplete="new-password"
                >
            </div>

            <div class="form-group">
                <label class="form-label">
                    Confirm New Password
                </label>

                <input
                    type="password"
                    name="confirmPassword"
                    class="form-control"
                    minlength="6"
                    required
                    autocomplete="new-password"
                >
            </div>

            <div
                id="password-message"
                class="password-form-message"
                style="display:none;"
            ></div>

            <button
                type="submit"
                class="btn btn-outline"
                id="change-password-btn"
            >
                <i class="fas fa-key"></i>
                Update Password
            </button>

        </form>

    </div>
</div>
            </main>
        </div>
    </div>

    <style>
        .profile-section .card,
        .security-section .card {
            background: var(--bg-dark);
            border: 1px solid var(--border-color);
        }

        .section-header {
    margin: 0 !important;
    padding: 15px 15px 15px !important;
    border: 0 !important;
}

        .section-header h2 {
            color: var(--text-lighter);
            font-size: 1.40rem;
            margin-bottom: 8px;
            display: flex;
            align-items: center;
            gap: 10px;
            font-weight: 700;
        }

        .section-header p {
            color: var(--text-dark);
            font-size: 0.8rem;
        }

        .form-row {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 20px;
        }

        .form-text {
            color: var(--text-dark);
            font-size: 0.85rem;
            margin-top: 5px;
            display: block;
        }

        #profile-form .btn {
            display: flex;
            align-items: center;
            gap: 8px;
            width: auto;
            padding: 12px 30px;
        }

        .security-section .btn {
            display: flex;
            align-items: center;
            gap: 8px;
        }

        

        @media (max-width: 768px) {
            .form-row {
                grid-template-columns: 1fr;
            }
        }
        input[type="date"].form-control {
    width: 100%;
    min-height: 48px;
    padding: 0 14px;
    border: 1px solid #b7eee0;
    border-radius: 12px;
    background: #ffffff;
    color: #334155;
    font-family: inherit;
    font-size: 0.9rem;
    box-sizing: border-box;
}

input[type="date"].form-control:focus {
    border-color: #10b981;
    outline: none;
    box-shadow: 0 0 0 3px rgba(16, 185, 129, 0.12);
}
.form-group {
    position: relative;
}

input[type="date"].form-control {
    position: relative;
    width: 100%;
    box-sizing: border-box;
}
    </style>
<script src="/navbar/navbar.js"></script>
    <script>
        

    document.getElementById('profile-form').addEventListener('submit', async function(e) {
    e.preventDefault();
    const form = e.target;
    const submitBtn = form.querySelector('button[type="submit"]');
    const originalText = submitBtn.innerHTML;
    
    submitBtn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Updating...';
    submitBtn.disabled = true;

        // Prepare form data
    const formData = {
        full_name: form.full_name.value,
        gender: form.gender.value,
        phone: form.phone.value,
        address: form.address.value,
        emergency_contact: form.emergency_contact.value
    };

    // Preserve Date of Birth exactly as selected.
// input[type="date"] always returns YYYY-MM-DD.
const dobInputValue = form.date_of_birth.value.trim();

if (dobInputValue) {
    if (!/^\d{4}-\d{2}-\d{2}$/.test(dobInputValue)) {
        alert('Please enter a valid Date of Birth.');
        submitBtn.disabled = false;
        submitBtn.innerHTML = originalText;
        return;
    }

    formData.date_of_birth = dobInputValue;
}
    try {
        const res = await fetch('/patient/profile', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(formData)
        });
        
        const json = await res.json();
        if (res.ok && json.success) {
            alert('Profile updated successfully!');
            location.reload();
        } else {
            alert('Failed to update profile: ' + (json.error || json.message || 'Unknown error'));
            submitBtn.innerHTML = originalText;
            submitBtn.disabled = false;
        }
    } catch (err) {
        console.error('Profile update error:', err);
        alert('Failed to update profile. Check console for details.');
        submitBtn.innerHTML = originalText;
        submitBtn.disabled = false;
    }
});

document
    .getElementById('change-password-form')
    .addEventListener('submit', async function (e) {

        e.preventDefault();

        const form = e.target;
        const button =
            document.getElementById('change-password-btn');

        const message =
            document.getElementById('password-message');

        const currentPassword =
            form.currentPassword.value;

        const newPassword =
            form.newPassword.value;

        const confirmPassword =
            form.confirmPassword.value;

        message.style.display = 'none';

        if (newPassword.length < 6) {
            message.textContent =
                'New password must be at least 6 characters long.';
            message.className =
                'password-form-message error';
            message.style.display = 'block';
            return;
        }

        if (newPassword !== confirmPassword) {
            message.textContent =
                'New passwords do not match.';
            message.className =
                'password-form-message error';
            message.style.display = 'block';
            return;
        }

        const originalText = button.innerHTML;

        button.disabled = true;
        button.innerHTML =
            '<i class="fas fa-spinner fa-spin"></i> Updating...';

        try {

            const response = await fetch(
                '/auth/change-password',
                {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify({
                        currentPassword,
                        newPassword,
                        confirmPassword
                    })
                }
            );

            const result =
                await response.json();

            if (!response.ok || !result.success) {
                throw new Error(
                    result.error ||
                    'Unable to update password.'
                );
            }

            message.textContent =
                'Password updated successfully.';
            message.className =
                'password-form-message success';
            message.style.display = 'block';

            form.reset();

        } catch (error) {

            message.textContent =
                error.message ||
                'Unable to update password.';

            message.className =
                'password-form-message error';

            message.style.display = 'block';

        } finally {

            button.disabled = false;
            button.innerHTML = originalText;
        }
    });
    </script>
        <%- include('../main/footer') %>

</body>
</html>