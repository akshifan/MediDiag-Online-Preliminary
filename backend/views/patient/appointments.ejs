

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>My Appointments - MediDiag</title>
    <link rel="stylesheet" href="/main/main.css">
    <link rel="stylesheet" href="/patient/appointments.css">
    <link rel="stylesheet" href="/navbar/navbar.css">
    <link rel="stylesheet" href="/footer/footer.css">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/portal/portal-fixes.css">
</head>
<body>
    <%- include('../headers/launchheader') %>

    <!-- Medical Background Elements -->
    <div class="medical-background">
        <i class="fas fa-heart medical-icon heart"></i>
        <i class="fas fa-stethoscope medical-icon stethoscope"></i>
        <i class="fas fa-pills medical-icon pill"></i>
        <i class="fas fa-hospital medical-icon hospital"></i>
        <i class="fas fa-clock medical-icon time"></i>
        <i class="fas fa-calendar-check medical-icon clipboard"></i>
    </div>

    <div class="container patient-dashboard">
        <div class="dashboard-grid">
            <aside class="sidebar">
                <div class="sidebar-header">
                    
                    <h3><%= patient.full_name %></h3>
            
                </div>
                <nav class="sidebar-nav">
                    <ul>
                        <li>
                            <a href="/patient/dashboard">
                                <i class="fas fa-tachometer-alt"></i>
                                Dashboard
                            </a>
                        </li>
                        <li>
                            <a href="/patient/doctors">
                                <i class="fas fa-user-md"></i>
                                Find Doctors
                            </a>
                        </li>
                        <li>
                            <a href="/patient/appointments" class="active">
                                <i class="fas fa-calendar-check"></i>
                                My Appointments
                            </a>
                        </li>
                        <li>
                            <a href="/patient/chats">
                                <i class="fas fa-comments"></i>
                                Chats
                            </a>
                        </li>
                        <li>
                            <a href="/patient/profile">
                                <i class="fas fa-user"></i>
                                Profile
                            </a>
                        </li>
                        <li>
                            <a href="/auth/logout">
                                <i class="fas fa-sign-out-alt"></i>
                                Logout
                            </a>
                        </li>
                    </ul>
                </nav>
            </aside>

            <main class="dashboard-content">
                <section class="appointments-title-section">
                    <h1><i class="fas fa-calendar-check"></i> My Appointments</h1>
                    <p>View and manage your appointment history.</p>
                </section>

                <% if (appointments && appointments.length > 0) { %>
                    <div class="appointments-grid" id="appointmentsGrid">
                        <% appointments.forEach((appointment, index) => { %>
                            <div class="card appointment-card" data-idx="<%= index %>" data-appointment-id="<%= appointment.id %>">
                                <div class="appointment-header">
                                    <div>
                                        <h3>Dr. <%= appointment.doctor_name %></h3>
                                        <p class="specialization"><%= appointment.specialization %></p>
                                    </div>
                                    <div class="appointment-status status-<%= appointment.status %>">
                                        <%= appointment.status %>
                                    </div>
                                </div>

                                <div class="appointment-details">
                                    <p><strong>Date &amp; Time:</strong> <%= new Date(appointment.appointment_date).toLocaleString() %></p>
                                    <p><strong>Symptoms:</strong> <%= appointment.symptoms %></p>
                                    <% if (appointment.preliminary_diagnosis) { %>
                                        <p><strong>Preliminary Diagnosis:</strong> <%= appointment.preliminary_diagnosis %></p>
                                    <% } %>
                                    <% if (appointment.doctor_notes) { %>
                                        <p><strong>Doctor Notes:</strong> <%= appointment.doctor_notes %></p>
                                    <% } %>
                                    <% if (appointment.prescription) { %>
                                        <div class="prescription">
                                            <strong>Prescription:</strong>
                                            <pre><%= appointment.prescription %></pre>
                                        </div>
                                    <% } %>
                                </div>

                                <div class="appointment-actions">
                                    <% if (appointment.status === 'scheduled' || appointment.status === 'rescheduled') { %>
                                        <button class="btn btn-outline cancel-btn" data-appointment-id="<%= appointment.id %>">
                                            <i class="fas fa-times"></i>
                                            Cancel
                                        </button>
                                        <button class="btn btn-primary reschedule-btn" data-appointment-id="<%= appointment.id %>">
                                            <i class="fas fa-calendar-alt"></i>
                                            Reschedule
                                        </button>
                                    <% } %>
                                </div>
                            </div>
                        <% }); %>
                    </div>

                    <div class="portal-pagination appointments-pagination" id="appointmentsPagination" aria-label="Appointment history pagination">
                        <button type="button" class="btn btn-outline" id="appointmentsPrev" disabled>
                            <i class="fas fa-chevron-left"></i> Previous
                        </button>
                        <span class="page-info" id="appointmentsPageInfo">Page 1 of 1</span>
                        <button type="button" class="btn btn-primary" id="appointmentsNext" disabled>
                            Next <i class="fas fa-chevron-right"></i>
                        </button>
                    </div>
                <% } else { %>
                    <div class="card empty-appointments">
                        <div class="empty-state">
                            <i class="fas fa-calendar-plus"></i>
                            <h3>No Appointments Yet</h3>
                            <p>You haven't booked any appointments yet.</p>
                            <a href="/patient/doctors" class="btn btn-primary">
                                <i class="fas fa-user-md"></i>
                                Find Doctors
                            </a>
                        </div>
                    </div>
                <% } %>
            </main>
        </div>
    </div>

    <!-- RESCHEDULE MODAL -->
    <div id="rescheduleModal" class="modal-overlay" style="display: none;">
        <div class="modal-card">
            <h3>Reschedule Appointment</h3>
            <input type="datetime-local" id="newDateTime" class="form-control" required>
            <div class="modal-actions">
                <button class="btn btn-primary" id="confirmReschedule">Confirm</button>
                <button class="btn btn-outline" id="cancelReschedule">Cancel</button>
            </div>
        </div>
    </div>

    <%- include('../main/footer') %>

    <script src="/navbar/navbar.js"></script>

    <script>
    /* =========================================================================
       1. PAGINATE APPOINTMENT HISTORY — 8 per page (2 x 4 grid)
       ========================================================================= */
    document.addEventListener('DOMContentLoaded', function () {
        var grid = document.getElementById('appointmentsGrid');
        var pagination = document.getElementById('appointmentsPagination');
        if (!grid || !pagination) return;

        var cards = Array.prototype.slice.call(grid.querySelectorAll('.appointment-card'));
        var prev = document.getElementById('appointmentsPrev');
        var next = document.getElementById('appointmentsNext');
        var info = document.getElementById('appointmentsPageInfo');
        var pageSize = 8;
        var page = 1;
        var totalPages = Math.max(1, Math.ceil(cards.length / pageSize));

        function renderPage() {
            var start = (page - 1) * pageSize;
            var end = start + pageSize;

            cards.forEach(function (card, index) {
                card.style.display = index >= start && index < end ? '' : 'none';
            });

            if (info) info.textContent = 'Page ' + page + ' of ' + totalPages;
            if (prev) prev.disabled = page <= 1;
            if (next) next.disabled = page >= totalPages;
        }

        prev.addEventListener('click', function () {
            if (page > 1) { page--; renderPage(); }
        });

        next.addEventListener('click', function () {
            if (page < totalPages) { page++; renderPage(); }
        });

        renderPage();
    });

    /* =========================================================================
       2. CANCEL APPOINTMENT
       ========================================================================= */
    document.addEventListener('DOMContentLoaded', function () {
        document.querySelectorAll('.cancel-btn').forEach(function (btn) {
            btn.addEventListener('click', async function () {
                var appointmentId = this.getAttribute('data-appointment-id');
                if (!confirm('Are you sure you want to cancel this appointment?')) return;

                var originalText = this.innerHTML;
                this.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Cancelling...';
                this.disabled = true;

                try {
                    var res = await fetch('/patient/cancel-appointment', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ appointment_id: appointmentId })
                    });
                    var json = await res.json();

                    if (res.ok && json.success) {
                        var card = this.closest('.appointment-card');
                        if (card) card.remove();

                        if (!document.querySelector('.appointment-card')) {
                            var grid = document.getElementById('appointmentsGrid');
                            if (grid) {
                                grid.outerHTML = [
                                    '<div class="card empty-appointments">',
                                    '  <div class="empty-state">',
                                    '    <i class="fas fa-calendar-plus"></i>',
                                    '    <h3>No Appointments Yet</h3>',
                                    '    <p>You haven\'t booked any appointments yet.</p>',
                                    '    <a href="/patient/doctors" class="btn btn-primary">',
                                    '      <i class="fas fa-user-md"></i> Find Doctors',
                                    '    </a>',
                                    '  </div>',
                                    '</div>'
                                ].join('');
                            }
                        }
                    } else {
                        alert('Failed to cancel appointment: ' + (json.error || 'Unknown error'));
                        this.innerHTML = originalText;
                        this.disabled = false;
                    }
                } catch (err) {
                    console.error('Cancel error:', err);
                    alert('Server error occurred.');
                    this.innerHTML = originalText;
                    this.disabled = false;
                }
            });
        });
    });

    /* =========================================================================
       3. RESCHEDULE MODAL
       ========================================================================= */
    document.addEventListener('DOMContentLoaded', function () {
        var modal = document.getElementById('rescheduleModal');
        var cancelModalBtn = document.getElementById('cancelReschedule');
        var confirmBtn = document.getElementById('confirmReschedule');
        if (!modal || !cancelModalBtn || !confirmBtn) return;

        document.querySelectorAll('.reschedule-btn').forEach(function (btn) {
            btn.addEventListener('click', function () {
                var appointmentId = this.getAttribute('data-appointment-id');
                modal.dataset.id = appointmentId;
                modal.style.display = 'flex';
            });
        });

        cancelModalBtn.addEventListener('click', function () {
            modal.style.display = 'none';
            modal.dataset.id = '';
            document.getElementById('newDateTime').value = '';
        });

        confirmBtn.addEventListener('click', async function () {
            var apptId = modal.dataset.id;
            var newDate = document.getElementById('newDateTime').value;

            if (!newDate) {
                alert('Please select a date and time.');
                return;
            }

            try {
                var res = await fetch('/patient/reschedule-appointment', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        appointment_id: apptId,
                        new_date: newDate
                    })
                });
                var json = await res.json();

                if (json.success) {
                    alert('Appointment rescheduled!');
                    var card = document.querySelector('.appointment-card[data-appointment-id="' + apptId + '"]');
                    if (card) {
                        var dtEl = card.querySelector('.appointment-details p');
                        if (dtEl) {
                            dtEl.innerHTML = '<strong>Date &amp; Time:</strong> ' + new Date(newDate).toLocaleString();
                        }
                    }
                } else {
                    alert('Rescheduling failed: ' + (json.error || 'Unknown error'));
                }
            } catch (error) {
                console.error('Reschedule error:', error);
                alert('Server error occurred.');
            }

            modal.style.display = 'none';
            modal.dataset.id = '';
            document.getElementById('newDateTime').value = '';
        });
    });
    </script>
</body>
</html>
