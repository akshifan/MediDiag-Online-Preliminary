<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link rel="stylesheet" href="/main/main.css">
    <link rel="stylesheet" href="/navbar/navbar.css">
    <link rel="stylesheet" href="/features/features.css">
    <link rel="stylesheet" href="/footer/footer.css">
     <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
</head>
<body>
    <%- include('../headers/launchheader') %>
    <div class="medical-background"></div>
    <main>
    <section class="features-hero">
        <div class="features-hero-container">
            <h1>MediDiag Features</h1>
            <p>Discover how our platform revolutionizes healthcare connectivity with innovative features</p>
        </div>
    </section>

    <section class="features-content">
        <div class="container">
            <div class="features-tabs">
                <button class="tab-btn active" data-tab="patients">For Patients</button>
                <button class="tab-btn" data-tab="doctors">For Doctors</button>
                <button class="tab-btn" data-tab="security">Security</button>
                <button class="tab-btn" data-tab="technology">Technology</button>
            </div>

            <!-- Patients Tab -->
            <div class="tab-content active" id="patients-tab">
                <div class="feature-section">
                    <h2 style="text-align: center; margin-bottom: 40px; color: var(--text-lighter);">Features Designed for Patients</h2>
                    
                    <div class="feature-grid">
                        <div class="feature-card animate-on-scroll">
                            <div class="icon">🔍</div>
                            <h3>Symptom Checker</h3>
                            <p style="color: var(--text-lighter);">Intelligent preliminary diagnosis based on your symptoms with detailed analysis and recommendations.</p>
                        </div>

                        <div class="feature-card animate-on-scroll">
                            <div class="icon">💬</div>
                            <h3>Live Chat Support</h3>
                            <p style="color: var(--text-lighter);">24/7 access for urgent queries and follow-ups with healthcare professionals.</p>
                        </div>

                        <div class="feature-card animate-on-scroll">
                            <div class="icon">📅</div>
                            <h3>Appointment Scheduling</h3>
                            <p style="color: var(--text-lighter);">Book consultations with verified doctors at your convenience with real-time availability.</p>
                        </div>

                        <div class="feature-card animate-on-scroll">
                            <div class="icon">📋</div>
                            <h3>Health Records</h3>
                            <p style="color: var(--text-lighter);">Secure digital storage for your medical history, prescriptions, and test results.</p>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Doctors Tab -->
            <div class="tab-content" id="doctors-tab">
                <div class="feature-section">
                    <h2 style="text-align: center; margin-bottom: 40px;color: var(--text-lighter);">Features for Healthcare Professionals</h2>
                    
                    <div class="feature-grid">
                        <div class="feature-card animate-on-scroll">
                            <div class="icon">🏥</div>
                            <h3>Virtual Clinic</h3>
                            <p style="color: var(--text-lighter);">Comprehensive platform to manage your online practice with patient management tools.</p>
                        </div>

                        <div class="feature-card animate-on-scroll">
                            <div class="icon">🤝</div>
                            <h3>Collaboration Tools</h3>
                            <p style="color: var(--text-lighter);">Secure platform for consulting with specialists and sharing patient cases.</p>
                        </div>

                        <div class="feature-card animate-on-scroll">
                            <div class="icon">📊</div>
                            <h3>Patient Analytics</h3>
                            <p style="color: var(--text-lighter);">Detailed insights into patient history, treatment progress, and health trends.</p>
                        </div>

                        <div class="feature-card animate-on-scroll">
                            <div class="icon">💊</div>
                            <h3>E-Prescription</h3>
                            <p style="color: var(--text-lighter);">Digital prescription system with medication tracking and renewal reminders.</p>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Security Tab -->
            <div class="tab-content" id="security-tab">
                <div class="security-features">
                    <div class="container">
                        <h2 style="text-align: center; margin-bottom: 40px; color: var(--text-lighter);">Platform Security</h2>
                        
                        <div class="feature-grid">
                            <div class="feature-card animate-on-scroll">
                                <div class="icon">🔒</div>
                                <h3>End-to-End Encryption</h3>
                                <p style="color: var(--text-lighter);">Encryption for all patient data and communication channels to ensure complete privacy.</p>
                            </div>

                            <div class="feature-card animate-on-scroll">
                                <div class="icon">📜</div>
                                <h3>HIPAA Compliance</h3>
                                <p style="color: var(--text-lighter);">Full compliance with healthcare data protection regulations and standards.</p>
                            </div>

                            <div class="feature-card animate-on-scroll">
                                <div class="icon">🔑</div>
                                <h3>Authentication</h3>
                                <p style="color: var(--text-lighter);">Enhanced security with multi-factor authentication for all user accounts.</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Technology Tab -->
            <div class="tab-content" id="technology-tab">
                <div class="tech-features">
                    <div class="container">
                        <h2 style="text-align: center; margin-bottom: 40px; color: var(--text-lighter);">Advanced Technology</h2>
                        
                        <div class="feature-grid">
                            <div class="feature-card animate-on-scroll">
                                <div class="icon">🤖</div>
                                <h3>AI Diagnosis Assistant</h3>
                                <p style="color: var(--text-lighter);">Advanced machine learning algorithms for accurate preliminary assessments.</p>
                            </div>

                            <div class="feature-card animate-on-scroll">
                                <div class="icon">🌐</div>
                                <h3>Cross-Platform Access</h3>
                                <p style="color: var(--text-lighter);">Seamless experience across web and mobile with synchronized data.</p>
                            </div>

                            <div class="feature-card animate-on-scroll">
                                <div class="icon">📈</div>
                                <h3>Real-time Analytics</h3>
                                <p style="color: var(--text-lighter);">Live dashboard with health trends, appointment statistics, and platform usage.</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
    </main>

    <%- include('../main/footer') %>
    
    <script src="/navbar/navbar.js"></script>
    <script src="/homepage/launchpage.js"></script>
    <script src="/scrollbutton/scrollbutton.js"></script>
    <script>
        // Tab functionality
         document.addEventListener('DOMContentLoaded', function() {
            const tabBtns = document.querySelectorAll('.tab-btn');
            const tabContents = document.querySelectorAll('.tab-content');

            tabBtns.forEach(btn => {
                btn.addEventListener('click', () => {
                    const tabId = btn.dataset.tab;
                    
                    // Remove active class from all buttons and contents
                    tabBtns.forEach(b => b.classList.remove('active'));
                    tabContents.forEach(c => c.classList.remove('active'));
                    
                    // Add active class to current button and content
                    btn.classList.add('active');
                    document.getElementById(`${tabId}-tab`).classList.add('active');
                });
            });
        });
    </script>
</body>
</html>